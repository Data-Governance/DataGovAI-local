DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ENABLE_DEV_LOGIN=true
ADMIN_EMAILS=admin@datagovai.local
ADMIN_SEED_EMAIL=admin@datagovai.local
ADMIN_SEED_PASSWORD=grsdemo
# Model provider: ollama (default) or bedrock.
# Switching providers switches the embedding model too — re-ingest all
# documents afterwards (embedding spaces don't mix).
LLM_PROVIDER=ollama

# Ollama (LLM + embeddings; default provider). Requires an Ollama server plus
# `ollama pull llama3.1:8b` and `ollama pull mxbai-embed-large`.
# mxbai-embed-large outputs 1024 dims to match vector(1024); nomic-embed-text
# (768) will NOT work. No reranker in ollama mode (merge order is used).
# OLLAMA_BASE_URL points at whatever host runs Ollama — localhost for a local
# server, or the host:11434 of the shared box on a deployed stage.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# AWS Bedrock (LLM + embeddings + rerank), selected with LLM_PROVIDER=bedrock.
# Runtime model invocation is currently blocked at the AWS organization level
# for this account, so this path cannot run until that is lifted; it is kept
# wired so it becomes the default again with one env change. Credentials come
# from the standard AWS chain: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env
# vars, a shared profile (AWS_PROFILE), or an EC2 instance role.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=amazon.rerank-v1:0

# Corpus sweep (weekly job). ARCHIVES_SOLR_URL overrides the Utah State
# Archives AXAEM Solr endpoint that `npm run sweep:archives` reads.
# GRSBOT_CORPUS_DIR is the corpus root: sweep:archives writes <root>/archives-grs,
# and ingest is pointed at <root>.
ARCHIVES_SOLR_URL=https://axaemarchives.utah.gov/solr/axaem/GRSItem
GRSBOT_CORPUS_DIR=~/grs-corpus

# DTS corpus hook — NOT WIRED TO A SOURCE YET. Rick's DTS manual-pull source
# list is still open (DECISIONS-PENDING GRSBOT-SWEEP-SOURCES). When set, the
# weekly job ingests this directory alongside the Archives corpus; the code
# that populates it lands with the source list.
GRSBOT_DTS_CORPUS_DIR=
