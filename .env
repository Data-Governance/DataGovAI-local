# LLM Provider Selection
LLM_PROVIDER=openai  # Options: openai, azure, anthropic, deepseek, local

# Embedding Model Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32  # Increased for better GPU utilization

# Document and Vector Store Paths
DOCS_DIR=./data

# Document Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SUPPORTED_FILE_TYPES=.txt,.pdf,.md,.doc,.docx,.html


# UI Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8505
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# LLM Configuration
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# Index Configuration
INDEX_PATH=data/index

# Query Configuration
RESPONSE_MODE=compact
NUM_SOURCES=3
SIMILARITY_TOP_K=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=test_results/rag_test.log

# Query Classification
ENABLE_QUERY_CLASSIFICATION=true
CLASSIFICATION_MODEL=gpt-3.5-turbo-0125
CLASSIFICATION_THRESHOLD=0.75 