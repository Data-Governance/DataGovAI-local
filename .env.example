# OpenAI API Configuration
OPENAI_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-ada-002

# Storage Configuration
STORAGE_PATH=./data
POSTGRES_CONNECTION=postgresql://kb_agent_user:password@localhost:5432/knowledge_base

# Processing Configuration
MAX_CHUNK_SIZE=1000
MIN_CHUNK_SIZE=100
OVERLAP_SIZE=50
MAX_RETRIES=3
RETRY_DELAY=1
EXTRACT_ENTITIES=true
EXTRACT_RELATIONSHIPS=true

# API Configuration
API_HOST=localhost
API_PORT=8080
API_DEBUG=false
RATE_LIMIT=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=generic_ai_agent.log

# Entity Extractor Configuration
USE_LOCAL_LLM=true
EXTRACTOR_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EXTRACTOR_DEVICE=cuda  # or cpu
EXTRACTOR_4BIT=true
EXTRACTOR_MAX_LENGTH=2048
EXTRACTOR_TEMPERATURE=0.1

# Storage
DOCUMENT_STORE_TYPE=memory
VECTOR_STORE_TYPE=memory
KNOWLEDGE_STORE_TYPE=memory

# API
API_KEY=your-api-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/knowledge_base.log

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=knowledge_base
MONGODB_USER=admin
MONGODB_PASSWORD=admin_password

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Docker
DOCKER_VOLUME_DIRECTORY=./volumes
NEO4J_PASSWORD=neo4j_password
MONGODB_PASSWORD=admin_password

# AI Model Configuration
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# Vector Store Configuration (Milvus)
MILVUS_COLLECTION=knowledge_base
VECTOR_DIMENSION=768  # Dimension for all-MiniLM-L6-v2 model

# Document Store Configuration (MongoDB)
MONGODB_COLLECTION=documents

# Knowledge Graph Configuration (Neo4j)
NEO4J_DATABASE=neo4j

# NLP Configuration
SPACY_MODEL=en_core_web_sm
ENABLE_GPU=false  # Set to true if GPU is available

# Document Processing Configuration
SUPPORTED_FILE_TYPES=.txt,.pdf,.md,.doc,.docx,.html
BATCH_SIZE=100

# API Configuration
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging Configuration
ENABLE_REQUEST_LOGGING=true

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017

# Neo4j Configuration
NEO4J_HOST=localhost
NEO4J_PORT=7687

# Milvus Configuration
MILVUS_DIMENSION=768  # For sentence-transformers default model

# Processing Configuration
MAX_TOKENS=512