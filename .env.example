# AI Model Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=1024
EMBEDDING_MAX_LENGTH=2048

# LLM Extractor Configuration
# Set USE_LOCAL_LLM=False to use OpenAI for extraction (requires OPENAI_API_KEY)
USE_LOCAL_LLM=False
EXTRACTOR_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EXTRACTOR_DEVICE=cuda
EXTRACTOR_4BIT=True

# Vector Store Configuration (PostgreSQL with pgvector)
# Connection string format: postgresql://user:password@host:port/database
# IMPORTANT: Make sure to include the password between : and @
POSTGRES_CONNECTION=postgresql://postgres:your_password_here@127.0.0.1:5432/knowledge_base
VECTOR_DIMENSION=768  # Dimension for all-mpnet-base-v2 model

# Document Store Configuration
DOCUMENT_STORE_TYPE=postgresql
VECTOR_STORE_TYPE=postgresql
KNOWLEDGE_STORE_TYPE=postgresql
BATCH_SIZE=100

# NLP Configuration
SPACY_MODEL=en_core_web_sm
ENABLE_GPU=true  # Using GPU for NLP processing

# Document Processing Configuration
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=200
OVERLAP_SIZE=100
SUPPORTED_FILE_TYPES=.txt,.pdf,.md,.doc,.docx,.html

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=generate-a-secure-random-key  # Generate using: openssl rand -hex 32
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
LOG_FILE=knowledge_base.log 

# Hugging Face API Key Configuration
HUGGING_FACE_HUB_TOKEN=your-huggingface-token-here

# UI Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false 